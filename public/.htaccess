# Hostinger (LiteSpeed/Apache) settings, copied into the site root on every build.

# --- Friendly error pages: every error status shows one of six pages (no technical text) ---
ErrorDocument 400 /400.html
ErrorDocument 402 /400.html
ErrorDocument 405 /400.html
ErrorDocument 406 /400.html
ErrorDocument 407 /400.html
ErrorDocument 408 /400.html
ErrorDocument 409 /400.html
ErrorDocument 411 /400.html
ErrorDocument 412 /400.html
ErrorDocument 413 /400.html
ErrorDocument 414 /400.html
ErrorDocument 415 /400.html
ErrorDocument 416 /400.html
ErrorDocument 417 /400.html
ErrorDocument 418 /400.html
ErrorDocument 421 /400.html
ErrorDocument 422 /400.html
ErrorDocument 423 /400.html
ErrorDocument 424 /400.html
ErrorDocument 425 /400.html
ErrorDocument 426 /400.html
ErrorDocument 428 /400.html
ErrorDocument 431 /400.html
ErrorDocument 401 /403.html
ErrorDocument 403 /403.html
ErrorDocument 451 /403.html
ErrorDocument 404 /404.html
ErrorDocument 410 /404.html
ErrorDocument 429 /429.html
ErrorDocument 500 /500.html
ErrorDocument 501 /500.html
ErrorDocument 505 /500.html
ErrorDocument 506 /500.html
ErrorDocument 507 /500.html
ErrorDocument 508 /500.html
ErrorDocument 510 /500.html
ErrorDocument 502 /503.html
ErrorDocument 503 /503.html
ErrorDocument 504 /503.html
ErrorDocument 511 /503.html

# --- Security headers ---
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "DENY"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"
    Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
    Header always set Cross-Origin-Opener-Policy "same-origin"

    # Pages: always revalidate so a fresh upload shows up immediately
    <FilesMatch "\.html$">
        Header set Cache-Control "no-cache"
    </FilesMatch>
    # Unfingerprinted files (favicons, hero art): cache for a day. Fingerprinted build
    # assets get a year via public/_astro/.htaccess.
    <FilesMatch "\.(png|svg|ico)$">
        Header set Cache-Control "public, max-age=86400"
    </FilesMatch>
</IfModule>

# --- Compression ---
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/css application/javascript image/svg+xml
</IfModule>

# --- Keep the deploy tool's bookkeeping file private ---
<Files ".ftp-deploy-sync-state.json">
    Require all denied
</Files>

# --- Keep AI scrapers out ---
# Known AI-training / scraping crawlers get a 403 (robots.txt stays readable so they can see the rules).
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteCond %{REQUEST_URI} !^/robots\.txt$
    RewriteCond %{HTTP_USER_AGENT} (GPTBot|ChatGPT-User|OAI-SearchBot|ClaudeBot|Claude-Web|anthropic-ai|CCBot|Bytespider|Amazonbot|PerplexityBot|cohere-ai|Diffbot|FacebookBot|meta-externalagent|ImagesiftBot|Omgilibot|Timpibot|Webzio|VelenPublicWebCrawler) [NC]
    RewriteRule .* - [F,L]
</IfModule>

# Machine-readable "no AI training" signals on every response
<IfModule mod_headers.c>
    Header always set X-Robots-Tag "noai, noimageai"
    Header always set tdm-reservation "1"
</IfModule>

# --- Don't expose directory listings ---
Options -Indexes
