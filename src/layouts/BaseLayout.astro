---
import {Font} from "astro:assets";
import '../styles/global.css';
import Minibar from "../components/Minibar.astro";

interface Props {
    title?: string;
    /** Tints the mobile browser's status bar area; also the page background behind it. */
    themeColor?: string;
}
const {title = 'Kino Koneko', themeColor = '#ffffff'} = Astro.props;
---

<!doctype html>
<html lang="en" class="h-full touch-pan-x overscroll-none motion-safe:scroll-smooth lg:touch-auto lg:overflow-hidden" style={`background:${themeColor}`}>
<head>
    <meta charset="utf-8"/>
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover"/>
    <meta name="theme-color" content={themeColor}/>
    <!-- opt out of AI training and image scraping (honoured by crawlers that follow these conventions) -->
    <meta name="robots" content="index, follow, noai, noimageai"/>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg"/>
    <link rel="icon" href="/favicon.ico"/>
    <meta name="generator" content={Astro.generator}/>
    <Font cssVariable="--font-retro-pop"/>
    <title>{title}</title>
</head>
<body class="h-full lg:fixed lg:inset-0 lg:overflow-hidden">
<a href="#content"
   class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-200 focus:rounded-md focus:bg-white focus:px-4 focus:py-2 focus:font-black focus:text-ink">
    Skip to content
</a>
<Minibar/>
<!-- No hand-scrolling: on touch screens `touch-pan-x` (html) blocks vertical swipes, on desktop the
     page is locked outright. Either way it only moves when a Minibar link is used. -->
<main id="content" tabindex="-1" class="outline-none h-full lg:overflow-y-hidden lg:motion-safe:scroll-smooth">
    <slot/>
</main>
<script>
    import {initThemeColor} from '../scripts/theme';
    import {initMotion} from '../scripts/motion';
    import {initCarousel} from '../scripts/carousel';

    initThemeColor();
    initMotion();
    initCarousel();
</script>
</body>
</html>
