---
import { Font } from "astro:assets";

import Hero from "../components/Hero.astro";
import Minibar from "../components/Minibar.astro";
import About from "../components/About.astro";
import AskMe from "../components/AskMe.astro";
import Showcase from "../components/Showcase.astro";
---

<!doctype html>
<html lang="en"
	  class="w-full h-full box-border p-0 m-0 motion-safe:scroll-smooth">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="user-scale=none;width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="generator" content={Astro.generator} />
		<Font cssVariable="--font-retro-pop" />
		<title>Kino Koneko</title>
	</head>
	<body class="box-border p-0 m-0 w-full h-full overflow-hidden">
		<Minibar></Minibar>
		<Hero></Hero>
		<About></About>
		<Showcase></Showcase>
		<AskMe></AskMe>
	</body>
</html>
