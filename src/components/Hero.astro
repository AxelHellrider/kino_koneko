---
import {SwiperWrapper, Swiper} from "astro-swiper";
import {Icon} from "astro-icon/components";
import {responsiveImage, type Banner} from '../lib/sanity';
import HeroSlide from './HeroSlide.astro';

interface Props {
    banners: Banner[];
}
const {banners} = Astro.props;
const swiperOptions = {
    autoplay: {delay: 7500},
    keyboard: false,
    cssMode: true,
    resizeObserver: true,
};
---

<section id="top" class="relative h-full w-full text-xl">
    <Swiper class="size-full" options={swiperOptions}
            role="region" aria-roledescription="carousel" aria-label="Featured banners">
        <SwiperWrapper class="touch-pan-x">
            {banners.map((b, i) => (
                <HeroSlide banner={b} index={i} total={banners.length} eager={i === 0}
                           figure={responsiveImage(b.figure, [480, 800, 1200])}/>
            ))}
        </SwiperWrapper>
    </Swiper>
    {banners.length > 1 && (
        <button type="button" data-hero-pause aria-pressed="false" aria-label="Pause banner rotation"
                class="group absolute left-4 top-[max(1rem,env(safe-area-inset-top))] z-40 grid size-11 place-items-center rounded-full border border-pink-200 bg-white/50 text-ink backdrop-blur-sm">
            <Icon name="pixelarticons:pause" aria-hidden="true" focusable="false" class="size-6 group-aria-pressed:hidden"/>
            <Icon name="pixelarticons:play" aria-hidden="true" focusable="false" class="hidden size-6 group-aria-pressed:block"/>
        </button>
    )}
</section>
