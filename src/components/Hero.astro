---
import {SwiperWrapper, Swiper, SwiperSlide} from "astro-swiper";
import {getBanners, urlFor} from '../lib/sanity';
import {colorVars} from '../lib/color';

const banners = await getBanners();
const swiperOptions = {
    autoplay: {delay: 7500},
    keyboard: false,
    cssMode: true,
    resizeObserver: true,
};
---

<section id="top" class="h-dvh w-full text-xl">
    <Swiper class="size-full" options={swiperOptions}>
        <SwiperWrapper>
            {banners.map((b, i) => (
                <SwiperSlide style={`--banner-bg: ${colorVars(b.background?.color) ?? 'transparent'}`}
                             class="flex! flex-col items-center justify-center gap-4 px-4 pb-24 [background:var(--banner-bg)]
                                    lg:flex-row lg:pb-0">
                    <div data-hero-text class="flex flex-col gap-4 max-lg:text-center lg:grow">
                        <h1 class="retro-heading text-2xl lg:text-4xl">{b.title}</h1>
                        {b.description && <span class="font-semibold text-md">{b.description}</span>}
                        {b.linkHref && <a href={b.linkHref}>{b.linkLabel ?? 'Take a look'}</a>}
                    </div>
                    <img data-hero-figure
                         src={urlFor(b.figure).format('webp').url()}
                         alt={b.figure.alt}
                         loading={i === 0 ? 'eager' : 'lazy'}
                         fetchpriority={i === 0 ? 'high' : 'auto'}
                         class="shrink-0 object-contain max-lg:max-h-[45dvh] max-lg:w-auto max-lg:max-w-full">
                </SwiperSlide>
            ))}
        </SwiperWrapper>
    </Swiper>
</section>
