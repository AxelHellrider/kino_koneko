---
import {SwiperWrapper, Swiper, SwiperSlide} from "astro-swiper";
import { getBanners, urlFor } from '../lib/sanity';
const banners = await getBanners();
---

<div class="w-full h-dvh text-xl flex flex-row items-center scroll-smooth scroll-mt-0"
     id="top">
    <Swiper class="mx-5! w-full h-full"
            options={{
                autoplay: {
                    delay: 7500
                },
                keyboard: false,
                cssMode: true,
                resizeObserver: true
            }}>
        <SwiperWrapper>
            {banners.map((b, i) => (
                    <SwiperSlide class="flex! flex-row items-center">
                        <div data-hero-text class="grow flex flex-col gap-4">
                            <h1 class="font-black italic text-xl lg:text-4xl uppercase tracking-tight
                                                   text-shadow-[3px_3px_0_#DAB2FF]">
                                {b.title}
                            </h1>
                            {b.description && <span class="font-semibold text-md">{b.description}</span>}
                            {b.linkHref && <a href={b.linkHref}>{b.linkLabel ?? 'Take a look'}</a>}
                        </div>
                        <img data-hero-figure
                             src={urlFor(b.figure).format('webp').url()}
                             alt={b.figure.alt}
                             loading={i === 0 ? 'eager' : 'lazy'}
                             fetchpriority={i === 0 ? 'high' : 'auto'}
                             class="shrink-0 grow-0">
                    </SwiperSlide>
            ))}
        </SwiperWrapper>
    </Swiper>
</div>