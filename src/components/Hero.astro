---
import {SwiperWrapper, Swiper, SwiperSlide} from "astro-swiper";
import {responsiveImage, type Banner} from '../lib/sanity';
import {colorVars, topEdgeColor} from '../lib/color';
import {safeHref} from '../lib/safe';

interface Props {
    banners: Banner[];
}
const {banners} = Astro.props;
const swiperOptions = {
    autoplay: {delay: 7500},
    keyboard: false,
    cssMode: true,
    resizeObserver: true,
};
---

<section id="top" class="h-full w-full text-xl">
    <Swiper class="size-full" options={swiperOptions}>
        <SwiperWrapper>
            {banners.map((b, i) => (
                <SwiperSlide data-theme-color={topEdgeColor(b.background?.color) ?? '#ffffff'}
                             style={`--banner-bg: ${colorVars(b.background?.color) ?? 'transparent'}`}
                             class="flex! flex-col items-center justify-center gap-4 px-4 pt-[env(safe-area-inset-top)] pb-24 [background:var(--banner-bg)]
                                    lg:flex-row lg:pb-0">
                    <div data-hero-text class="flex flex-col gap-4 max-lg:text-center lg:grow">
                        <h1 class="retro-heading text-2xl lg:text-4xl">{b.title}</h1>
                        {b.description && <span class="font-semibold text-md">{b.description}</span>}
                        {safeHref(b.linkHref) && <a href={safeHref(b.linkHref)}>{b.linkLabel ?? 'Take a look'}</a>}
                    </div>
                    <img data-hero-figure
                         {...responsiveImage(b.figure, [480, 800, 1200])}
                         sizes="(max-width: 1024px) 80vw, 40vw"
                         alt={b.figure.alt}
                         loading={i === 0 ? 'eager' : 'lazy'}
                         fetchpriority={i === 0 ? 'high' : 'auto'}
                         class="shrink-0 object-contain max-lg:max-h-[45dvh] max-lg:w-auto max-lg:max-w-full">
                </SwiperSlide>
            ))}
        </SwiperWrapper>
    </Swiper>
</section>
