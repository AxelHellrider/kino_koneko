---
import {SwiperWrapper, Swiper, SwiperSlide} from "astro-swiper";
---

<div class="w-full h-dvh text-xl flex flex-row items-center scroll-smooth scroll-mt-0"
     id="top">
    <Swiper class="mx-5! w-full h-full"
            options={{
                autoplay: {
                    delay: 7500
                },
                keyboard: false,
                cssMode: true,
                resizeObserver: true
            }}>
        <SwiperWrapper>
            <SwiperSlide class="group flex! flex-row items-center">
                <div class="grow flex flex-col gap-4 opacity-0 -translate-x-6
                            transition-all duration-1200 ease-out group-[.swiper-slide-active]:opacity-100
                            group-[.swiper-slide-active]:translate-x-0 motion-reduce:transition-none">
                    <h1 class="font-black italic text-xl lg:text-4xl uppercase tracking-tight
                       text-shadow-[3px_3px_0_#DAB2FF]">
                        kino koneko
                    </h1>
                    <span class="font-semibold text-md">Check out what we've got for you!</span>
                </div>
                <!-- todo: Animate the figure's position from right to left -->
                <img class="opacity-0 translate-x-6
                            transition-all duration-1200 ease-out group-[.swiper-slide-active]:opacity-100
                            group-[.swiper-slide-active]:translate-x-0 motion-reduce:transition-none shrink-0 grow-0"
                     src="/sailor_moon_stock_art.png"
                     alt="Sailor Moon">
            </SwiperSlide>
            <SwiperSlide class="group flex! flex-row items-center">
                <div class="grow flex flex-col gap-4 opacity-0 -translate-x-6
                            transition-all duration-1200 ease-out group-[.swiper-slide-active]:opacity-100
                            group-[.swiper-slide-active]:translate-x-0 motion-reduce:transition-none">
                    <h1 class="font-black italic text-xl lg:text-4xl uppercase tracking-tight
                       text-shadow-[3px_3px_0_#DAB2FF]">
                        Asthmatic Wizard Collab
                    </h1>
                    <span class="font-semibold text-md">Check out what we've got for you!</span>
                </div>
                <!-- todo: Animate the figure's position from right to left -->
                <img class="opacity-0 translate-x-6
                            transition-all duration-1200 ease-out group-[.swiper-slide-active]:opacity-100
                            group-[.swiper-slide-active]:translate-x-0 motion-reduce:transition-none shrink-0 grow-0"
                     src="/sailor_moon_stock_art.png"
                     alt="Sailor Moon">
            </SwiperSlide>
        </SwiperWrapper>
    </Swiper>
</div>