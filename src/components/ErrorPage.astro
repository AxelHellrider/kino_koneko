---
import BaseLayout from '../layouts/BaseLayout.astro';

interface Props {
    code: number;
    title: string;
}
const {code, title} = Astro.props;
---

<BaseLayout title={`${title} - Kino Koneko`}>
    <div class="flex h-full w-full flex-col items-center p-4 pt-[max(1rem,env(safe-area-inset-top))] pb-24 text-xl lg:flex-row">
        <div class="flex grow flex-col items-center justify-center gap-2 text-center">
            <h1 class="retro-heading text-xl lg:text-[70px]">{code}</h1>
            <p class="font-semibold"><slot/></p>
        </div>
        <!-- todo: Animate the figure's position from right to left -->
        <img class="shrink-0 max-lg:max-h-[45dvh] max-lg:w-auto"
             src="/sailor_moon_stock_art.png"
             alt="Sailor Moon">
    </div>
</BaseLayout>
