---
import Section from './Section.astro';
import ContactLink from './ContactLink.astro';
import {EMAIL, INSTAGRAM_HANDLE, INSTAGRAM_URL} from '../lib/contact';
---

<Section id="askme" label="Contact" class="items-center justify-center">
    <div class="mx-auto flex max-w-md flex-col items-center gap-4 px-6 text-center">
        <p data-anim="text">Having questions? Send a message on my Instagram page or mail me for more.</p>
        <ContactLink data-anim="text" href={INSTAGRAM_URL}>{INSTAGRAM_HANDLE}</ContactLink>
        <ContactLink data-anim="text" href={`mailto:${EMAIL}`}>{EMAIL}</ContactLink>
    </div>
</Section>
