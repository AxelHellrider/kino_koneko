---
import {getProducts} from '../lib/sanity';
import Section from './Section.astro';
import TarotCard from './TarotCard.astro';

// already ordered by `order` ascending, so the first card drawn is the lowest order
const products = await getProducts();

const deckCard = 'absolute inset-0 rounded-2xl border-[3px] border-ink';
const deckLayer = `${deckCard} bg-[#CDB4FF]`;
---

<Section id="designs" class="flex-col items-center gap-6 pt-10">
    <h2 class="retro-heading text-2xl lg:text-3xl">Pick a card</h2>

    {products.length > 0 && (
        <div data-deck-root class="flex w-full max-w-6xl flex-col items-center gap-8">

            <!-- the deck -->
            <div class="flex flex-col items-center gap-3">
                <button type="button" data-deck-btn
                        class="group relative aspect-[2/3] w-28 touch-manipulation sm:w-36
                               focus-visible:outline-4 focus-visible:outline-offset-8 focus-visible:outline-ink">
                    <span data-deck-layer class:list={[deckLayer, 'translate-1.5']}></span>
                    <span data-deck-layer class:list={[deckLayer, 'translate-1']}></span>
                    <span data-deck-layer class:list={[deckLayer, 'translate-0.5']}></span>
                    <span data-deck-top
                          class:list={[deckCard, 'grid place-items-center text-3xl shadow-[4px_4px_0_var(--color-ink)]',
                              'bg-[repeating-linear-gradient(45deg,#FFB3D9_0_10px,#FFD6EC_10px_20px)]',
                              'group-data-[empty=true]:border-dashed group-data-[empty=true]:bg-white group-data-[empty=true]:opacity-60']}>
                        <span aria-hidden="true">☾</span>
                    </span>
                </button>
                <p class="text-center text-sm font-semibold">
                    <span data-deck-label>Tap the deck to draw a card</span>
                    <span class="block text-xs opacity-70" data-deck-count aria-live="polite"></span>
                </p>
            </div>

            <!-- drawn cards -->
            <div data-spread
                 class="grid w-full grid-cols-2 gap-x-4 gap-y-6 sm:grid-cols-3 sm:gap-x-6 lg:grid-cols-4 lg:gap-8">
                {products.map((p, i) => <TarotCard product={p} index={i} eager={i === 0}/>)}
            </div>
        </div>
    )}
</Section>

<script>
    import {initDeck} from '../scripts/deck';

    const root = document.querySelector<HTMLElement>('[data-deck-root]');
    if (root) initDeck(root);
</script>
