---
import { getProducts } from '../lib/sanity';
import TarotCard from './TarotCard.astro';
const products = await getProducts();
---

<section id="designs" class="min-h-dvh p-4">
    <div class="mx-auto flex max-w-6xl snap-x snap-mandatory gap-6 overflow-x-auto px-2 py-10
              lg:grid lg:grid-cols-4 lg:gap-8 lg:overflow-auto">
        {products.map((p, i) => <TarotCard product={p} index={i} eager={i === 0} />)}
    </div>
</section>