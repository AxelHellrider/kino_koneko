---
interface Props {
    id: string;
    /** accessible name for the section landmark */
    label?: string;
    class?: string;
}
const {id, label, class: className} = Astro.props;
---

<!-- bottom padding on mobile keeps content clear of the floating Minibar -->
<section id={id} aria-label={label} data-anim-group data-theme-color="#ffffff" class:list={['flex h-full bg-white px-4 pt-[max(1rem,env(safe-area-inset-top))] pb-28 text-xl lg:pb-4', className]}>
    <slot/>
</section>
