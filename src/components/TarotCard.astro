---
import {urlFor, type Product} from '../lib/sanity';

interface Props {
    product: Product;
    index: number;
    eager?: boolean
}
const {product: p, index, eager = false} = Astro.props;

const ROMAN = ['0', 'I', 'II', 'III', 'IV', 'V', 'VI', 'VII', 'VIII', 'IX', 'X', 'XI', 'XII', 'XIII', 'XIV', 'XV', 'XVI', 'XVII', 'XVIII', 'XIX', 'XX', 'XXI'];
const numeral = ROMAN[(index + 1) % ROMAN.length];

// cycle pastel pairs per card
const PALETTE = [
    ['#FFB3D9', '#FFD6EC'],
    ['#CDB4FF', '#E4D6FF'],
    ['#A8DCFF', '#D2EEFF'],
    ['#B8F2D8', '#DDF8EC'],
    ['#FFF1A8', '#FFF8D0'],
];
const [c1, c2] = PALETTE[index % PALETTE.length];
const tilt = index % 2 === 0 ? '-2deg' : '2deg';

const art = p.main_artwork
    ? urlFor(p.main_artwork).width(640).format('webp').url()
    : undefined;
---

<article
        data-tarot
        class="tarot group relative aspect-[2/3] w-64 shrink-0 snap-center lg:w-auto"
        style={`--c1:${c1}; --c2:${c2}; --tilt:${tilt}`}>

    <div class="tarot-lift size-full">
        <div class="tarot-inner relative size-full" data-flip>

            <!-- FRONT -->
            <div class="tarot-face absolute inset-0 rounded-2xl border-[3px] border-[#1B1030]
                  bg-linear-to-b from-(--c1) to-white shadow-[6px_6px_0_#1B1030]">
                <div class="absolute inset-2 rounded-xl border-2 border-[#1B1030]/70"></div>

                <span class="absolute left-1/2 top-3.5 -translate-x-1/2 font-black italic text-sm tracking-widest">
                  {numeral}
                </span>
                <span aria-hidden="true" class="absolute left-4 top-3.5 text-xs">✦</span>
                <span aria-hidden="true" class="absolute right-4 top-3.5 text-xs">✦</span>

                <!-- arched art window -->
                <div class="absolute inset-x-6 top-10 bottom-20 overflow-hidden border-2 border-[#1B1030] bg-(--c2)">
                    {art
                        ? <img src={art} alt={p.title}
                               loading={eager ? 'eager' : 'lazy'}
                               fetchpriority={eager ? 'high' : 'auto'}
                               width="640" height="960"
                               class="size-full object-bottom"/>
                        :
                            <div class="grid size-full place-items-center text-4xl" aria-hidden="true">✦</div>}
                </div>

                <!-- name plate -->
                <div class="absolute inset-x-5 bottom-4 rounded-md border-2 border-[#1B1030] bg-white px-2 py-1.5 text-center">
                    <h3 class="font-black italic text-sm uppercase leading-tight tracking-tight">{p.title}</h3>
                </div>
            </div>

            <!-- BACK -->
            <div class="tarot-face tarot-back absolute inset-0 flex flex-col items-center justify-center gap-3
                  rounded-2xl border-[3px] border-[#1B1030] bg-(--c1) p-6 text-center
                  shadow-[6px_6px_0_#1B1030]">
                <div class="absolute inset-2 rounded-xl border-2 border-[#1B1030]/70"></div>
                <span aria-hidden="true" class="text-xl">☾</span>
                <h3 class="font-black italic uppercase leading-tight">{p.title}</h3>
                {p.description && <p class="text-xs line-clamp-11">{p.description}</p>}
                <p class="text-[10px] opacity-70">Tap to flip back</p>
            </div>

        </div>
    </div>

    <!-- one real button covers the card -->
    <button type="button" data-flip-btn aria-pressed="false"
            aria-label={`Flip card: ${p.title}`}
            class="absolute inset-0 z-10 rounded-2xl focus-visible:outline-4 focus-visible:outline-offset-4 focus-visible:outline-[#1B1030]">
    </button>
</article>

<style>
    .tarot {
        perspective: 1200px;
    }

    .tarot-lift {
        transform: rotate(var(--tilt));
        transition: transform 0.25s ease;
    }

    @media (hover: hover) {
        .tarot:hover .tarot-lift {
            transform: translateY(-10px) rotate(0deg);
        }
    }

    .tarot-inner {
        transform-style: preserve-3d;
        transition: transform 0.7s cubic-bezier(0.2, 0.8, 0.2, 1);
    }

    .tarot-inner[data-flipped='true'] {
        transform: rotateY(180deg);
    }

    .tarot-face {
        backface-visibility: hidden;
        -webkit-backface-visibility: hidden;
    }

    .tarot-back {
        transform: rotateY(180deg);
    }

    @media (prefers-reduced-motion: reduce) {
        .tarot-inner, .tarot-lift {
            transition: none;
        }
    }
</style>

<script>
    document.querySelectorAll<HTMLElement>('[data-tarot]').forEach((card) => {
        const inner = card.querySelector<HTMLElement>('[data-flip]');
        const btn = card.querySelector<HTMLButtonElement>('[data-flip-btn]');
        if (!inner || !btn) return;
        btn.addEventListener('click', () => {
            const flipped = inner.dataset.flipped !== 'true';
            inner.dataset.flipped = String(flipped);
            btn.setAttribute('aria-pressed', String(flipped));
        });
    });
</script>