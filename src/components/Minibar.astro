---
import {Icon} from "astro-icon/components";

const navMap = [
    {icon: 'pixelarticons:home', label: 'Home', anchor: '/#top'},
    {icon: 'pixelarticons:info-box', label: 'About', anchor: '/#about'},
    {icon: 'pixelarticons:shirt', label: 'Designs', anchor: '/#designs'},
    {icon: 'pixelarticons:chat', label: 'Ask me', anchor: '/#askme'},
];
---

<nav aria-label="Main"
     class="fixed z-100 transition-[right,opacity]
            max-lg:bottom-[max(0.75rem,env(safe-area-inset-bottom))] max-lg:left-1/2 max-lg:-translate-x-1/2
            lg:top-1/2 lg:-right-10 lg:-translate-y-1/2 lg:opacity-50 lg:hover:right-4 lg:hover:opacity-100">
    <div class="flex flex-row gap-2 rounded-full border border-pink-200 bg-white/50 p-3 backdrop-blur-sm lg:flex-col">
        {navMap.map(({icon, label, anchor}) => (
            <a href={anchor} class="-m-1 p-1">
                <Icon name={icon} aria-label={label} class="size-8 lg:hover:scale-110"/>
            </a>
        ))}
    </div>
</nav>
